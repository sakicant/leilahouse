# The admin app must never be cached: a stale copy would edit the calendar
# with out-of-date rules. The public site's long-cache rules live one level up.
<IfModule mod_headers.c>
  Header set Cache-Control "no-store, must-revalidate"
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>

# Optional second lock. Create the password file outside the web root with
#   htpasswd -c /home/USER/.leila-htpasswd hrvojka
# then uncomment these four lines. The panel still asks for its own password.
# AuthType Basic
# AuthName "House Leila admin"
# AuthUserFile /home/USER/.leila-htpasswd
# Require valid-user
